{
	"schemaVersion": 1,
	"id": "passablefoliage",
	"version": "${version}",
	"name": "Passable Foliage",
	"description": "Makes leaves and configured foliage passable while preserving configurable movement, fall-damage, sound and pathfinding behavior.",
	"authors": [
		"Snownee"
	],
	"contributors": [
		"ChromusMaster"
	],
	"contact": {
		"homepage": "https://github.com/ChromusMaster/PassableFoliageForked",
		"sources": "https://github.com/ChromusMaster/PassableFoliageForked",
		"issues": "https://github.com/ChromusMaster/PassableFoliageForked/issues"
	},
	"license": "MIT",
	"environment": "*",
	"mixins": [
		"passablefoliage.mixins.json"
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": ">=0.158.0"
	},
	"entrypoints": {
		"main": [
			"snownee.passablefoliage.util.CommonProxy"
		],
		"fabric-datagen": [
			"snownee.passablefoliage.datagen.PassableFoliageDataGen"
		]
	}
}
